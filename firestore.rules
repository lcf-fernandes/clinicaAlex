rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return myData().role;
    }

    // Conta bloqueada (ou apagada, nesse caso myData() já falha e isso
    // nunca chega a ser avaliado) perde acesso aos dados na hora,
    // mesmo com uma sessão do Authentication ainda válida no navegador.
    function isActive() {
      return myData().active == true;
    }

    function isAuthorized() {
      return isSignedIn() && isActive();
    }

    // Secretaria/admin: acesso de verdade ao dia a dia da clínica.
    function isStaff() {
      return isAuthorized() && role() in ['admin', 'secretary'];
    }

    // Login de profissional: só visualização do que é dele mesmo.
    function myProfessionalId() {
      return myData().professionalId;
    }

    // Cada usuário lê o próprio perfil (username, role, permissions);
    // um admin lê todos (precisa pra listar o painel Usuários — a
    // secretaria não lê a lista, só cria). Admin cria/edita/apaga
    // qualquer usuário; secretaria só CRIA usuário com role
    // "professional" (não edita nem apaga ninguém, nem cria
    // admin/secretary — isso é via Console por enquanto se precisar).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || role() == 'admin');
      allow create: if isSignedIn() && (
        role() == 'admin' ||
        (role() == 'secretary' && request.resource.data.role == 'professional')
      );
      allow update, delete: if isSignedIn() && role() == 'admin';
    }

    // Lookup público usuário -> e-mail, usado só pra resolver o e-mail
    // ANTES do login (ainda sem sessão). Guarda só {email, uid} — nada
    // de role/active/permissions aqui, isso fica em users/{uid}.
    // Criação acompanha a de users/{uid} acima (admin ou secretaria
    // criando profissional); editar/apagar um vínculo já existente
    // continua só por admin.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && role() in ['admin', 'secretary'];
      allow update, delete: if isSignedIn() && role() == 'admin';
    }

    // Só secretaria/admin mexem nisso — um profissional logado não
    // precisa (nem deve) ver a lista de outros profissionais, pacientes,
    // bloqueios, pacientes fixos, reemplazos ou lista de espera.
    match /professionals/{id} {
      allow read, write: if isStaff();
    }

    match /patients/{id} {
      allow read, write: if isStaff();
    }

    match /blocks/{id} {
      allow read, write: if isStaff();
    }

    match /recurringRules/{id} {
      allow read, write: if isStaff();
    }

    match /scheduleExceptions/{id} {
      allow read, write: if isStaff();
    }

    match /waitlist/{id} {
      allow read, write: if isStaff();
    }

    // Sessões: secretaria/admin têm acesso total. Um profissional só
    // lê (nunca escreve) as próprias sessões — e só funciona se a
    // consulta do app já vier filtrada por professionalId (ver
    // useMySessions), já que o Firestore nega a query inteira se
    // algum documento do resultado não bater com a regra.
    match /sessions/{id} {
      allow read: if isStaff() || (isAuthorized() && resource.data.professionalId == myProfessionalId());
      allow write: if isStaff();
    }

    // Liquidação diária: mesma lógica — profissional só lê a própria,
    // nunca edita.
    match /dailySettlements/{id} {
      allow read: if isStaff() || (isAuthorized() && resource.data.professionalId == myProfessionalId());
      allow write: if isStaff();
    }

    // Trilha de auditoria: staff só CRIA entradas (é quem gera as
    // ações), só admin LÊ, e ninguém edita nem apaga — registro
    // imutável pelo próprio app.
    match /auditLog/{id} {
      allow create: if isStaff();
      allow read: if isSignedIn() && role() == 'admin';
      allow update, delete: if false;
    }

    // Documento único com a quantidade de salas por dia da semana.
    // Secretaria só lê (pro aviso de ocupação em Profissionais); só
    // admin edita, é uma decisão estrutural da clínica.
    match /clinicSettings/{id} {
      allow read: if isStaff();
      allow write: if isSignedIn() && role() == 'admin';
    }
  }
}
