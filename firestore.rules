rules_version = '2';

// Fase 1: qualquer usuário autenticado (a secretária logada via Firebase
// Auth) pode ler e escrever. Quando entrarmos em papéis (secretária vs
// profissional, seção 9 do documento de arquitetura), isso se refina por
// coleção.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
