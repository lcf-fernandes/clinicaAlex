rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Cada usuário lê o próprio perfil (username, role, permissions);
    // um admin lê todos. Só admin pode criar/editar/remover usuários —
    // isso é feito manualmente pelo Firebase Console por enquanto.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || role() == 'admin');
      allow write: if isSignedIn() && role() == 'admin';
    }

    // Lookup público usuário -> e-mail, usado só pra resolver o e-mail
    // ANTES do login (ainda sem sessão). Guarda só {email, uid} — nada
    // de role/active/permissions aqui, isso fica em users/{uid}.
    // Escrita só por admin (criação de usuário continua manual por
    // enquanto).
    match /usernames/{username} {
      allow read: if true;
      allow write: if isSignedIn() && role() == 'admin';
    }

    // Fase 1: qualquer usuário autenticado (secretária ou admin) pode
    // ler/escrever. Quando entrarmos em permissões por seção (ver
    // UserPermissions em src/types/user.ts), cada coleção sensível
    // passa a checar role()/permissions() aqui.
    match /professionals/{id} {
      allow read, write: if isSignedIn();
    }

    match /patients/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
